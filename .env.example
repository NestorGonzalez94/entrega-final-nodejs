PORT=3101

# Clave usada para firmar y validar los tokens JWT. Usá un valor largo y secreto.
JWT_SECRET=una_clave_larga_y_secreta
JWT_EXPIRES_IN=2h

# Credenciales de acceso. En producción deben estar guardadas de forma segura.
AUTH_EMAIL=admin@techlab.com
AUTH_PASSWORD=123456

# Credenciales de la app web de Firebase (Configuración del proyecto > Tus apps).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
